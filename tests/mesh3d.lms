p = _lmcode_ cli="lmfluid" install="github:lmctl-ai/lmfluid@latest";
let mesh = fluid.box(4, 4, 4, 1.0, 1.0, 1.0);
fluid.assert_true(mesh.dimension() == 3);
fluid.assert_true(mesh.elements() == 64);
let field = fluid.poisson(mesh, 2).source("-6.0").dirichlet(0, "x*x + y*y + z*z").solve();
fluid.assert_close(field.value(0.5, 0.5, 0.5, 0), 0.75, 0.000001);
fluid.assert_true(field.sample(3, 3, 3).rows() == 27);
end _lmcode_
savedsl(p, "build/mesh3d.dslb");
