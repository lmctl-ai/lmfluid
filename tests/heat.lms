p = _dsl_ cli="lmfluid" install="github:lmctl-ai/lmfluid@latest";
let mesh = fluid.rect(20, 20, 1.0, 1.0);
let problem = fluid.heat(mesh, 1).diffusion("1.0").initial("sin(3.141592653589793*x)*sin(3.141592653589793*y)").dirichlet(0, "0.0");
let field = problem.evolve(0.01, 0.001);
let expected = 0.8208687174155399;
fluid.assert_close(field.value(0.5, 0.5), expected, 0.03);
fluid.assert_close(field.time(), 0.01, 0.000001);
end _dsl_
savedsl(p, "build/heat.dslb");
