mkdir("build/examples");
p = _dsl_ cli="lmfluid" install="github:lmctl-ai/lmfluid@latest";
let p=fluid.heat(fluid.rect(8,8,1.0,1.0),2).initial("sin(pi*x)*sin(pi*y)");for(i in range(0,24)){let t=0.004*float(i);let f=p.evolve(t,0.001);fluid.assert_close(f.value(0.5,0.5),fluid.eval("exp(-2*pi*pi*"+str(t)+")"),0.012);f.sample(31,31).save_csv("build/examples/heat_clock-"+str(i)+".csv");}
end _dsl_
savedsl(p, "build/heat_clock.dslb");
r = system ${dsl_cli(p)} --dsl build/heat_clock.dslb;
assert(r.code == 0);

mkdir("build/visual");
mkdir("images");
v = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/heat_clock.png",900,520);
plot.cmd("set datafile separator ','");
plot.cmd("set border 3");
plot.cmd("set lmargin 14");
plot.cmd("set rmargin 12");
plot.cmd("set tics nomirror");
plot.cmd("set grid back lc rgb '#e4e9ef'");
plot.cmd("set key outside top center horizontal");
plot.cmd("set style line 1 lc rgb '#007f86' lw 3");
plot.cmd("set style line 2 lc rgb '#df6b38' lw 3");
plot.cmd("set style line 3 lc rgb '#5864a8' lw 3");
plot.cmd("set title 'Cooling eigenmode at t=0.092; initial peak was 1'");
plot.cmd("set xlabel 'x (model units)'");
plot.cmd("set ylabel 'y (model units)'");
plot.cmd("set size ratio -1");
plot.cmd("set palette defined (0 '#17324d', 0.5 '#159895', 1 '#fff2b2')");
plot.cmd("set cblabel 'Field value'");
plot.cmd("unset key");
plot.cmd("set cbrange [0:1]");
plot.cmd("set cblabel 'Temperature / initial peak'");
plot.cmd("set xrange [0:1]");
plot.cmd("set yrange [0:1]");
plot.cmd("plot 'build/examples/heat_clock-23.csv' using 1:2:4 with image");
plot.close();
for(k in range(0,24)) {
plot.png("build/visual/heat_clock-frame-"+str(k)+".png",900,520);
plot.cmd("set title 'Cooling plate: t = "+str(0.004*float(k))+"'");
plot.cmd("plot 'build/examples/heat_clock-"+str(k)+".csv' using 1:2:4 with image");
plot.close();
}
end _dsl_
savedsl(v,"build/visual/heat_clock.dslb");
r = system ${dsl_cli(v)} --dsl build/visual/heat_clock.dslb;
if (r.code!=0) { println(r.stdout); println(r.stderr); }
assert(r.code==0);

println("wrote images/heat_clock.png");
