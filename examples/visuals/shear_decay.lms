mkdir("build/visual");
mkdir("docs/images");
v = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("docs/images/shear_decay.png",900,520);
plot.cmd("set datafile separator ','");
plot.cmd("set border 3");
plot.cmd("set lmargin 14");
plot.cmd("set rmargin 12");
plot.cmd("set tics nomirror");
plot.cmd("set grid back lc rgb '#e4e9ef'");
plot.cmd("set key outside top center horizontal");
plot.cmd("set style line 1 lc rgb '#007f86' lw 3");
plot.cmd("set style line 2 lc rgb '#df6b38' lw 3");
plot.cmd("set style line 3 lc rgb '#5864a8' lw 3");
plot.cmd("set xrange [0:32]");
plot.cmd("set title 'Viscous diffusion damps a sinusoidal shear wave'");
plot.cmd("set xlabel 'y (lattice units)'");
plot.cmd("set ylabel 'Streamwise velocity (lattice units)'");
plot.cmd("plot 0.03*sin(2*pi*x/32) with lines ls 3 dt 2 title 'Initial', 'build/examples/shear_decay.csv' using ($1==0.5?$2:1/0):4 with points pt 7 ps 0.8 lc rgb '#007f86' title 'D2Q9 at step 400', 0.03*exp(-0.1*(2*pi/32)**2*400)*sin(2*pi*x/32) with lines ls 2 title 'Exact decay'");
plot.close();
end _dsl_
savedsl(v,"build/visual/shear_decay.dslb");
r = system ${dsl_cli(v)} --dsl build/visual/shear_decay.dslb;
if (r.code!=0) { println(r.stdout); println(r.stderr); }
assert(r.code==0);
