mkdir("build/examples");
p = _dsl_ cli="lmfluid" install="github:lmctl-ai/lmfluid@latest";
let p=fluid.heat(fluid.rect(16,16,1.0,1.0),2).initial("sin(pi*x)*sin(pi*y)+0.3*sin(3*pi*x)*sin(pi*y)");let a=p.evolve(0.0,0.0002);let b=p.evolve(0.02,0.0002);fluid.assert_close(b.value(0.5,0.5),fluid.eval("exp(-2*pi*pi*0.02)-0.3*exp(-10*pi*pi*0.02)"),0.003);a.sample(41,41).save_csv("build/examples/heated_plate_initial.csv");b.sample(41,41).save_csv("build/examples/heated_plate_final.csv");
end _dsl_
savedsl(p, "build/heated_plate.dslb");
r = system ${dsl_cli(p)} --dsl build/heated_plate.dslb;
assert(r.code == 0);

mkdir("build/visual");
mkdir("images");
v = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/heated_plate.png",900,520);
plot.cmd("set datafile separator ','");
plot.cmd("set border 3");
plot.cmd("set lmargin 14");
plot.cmd("set rmargin 12");
plot.cmd("set tics nomirror");
plot.cmd("set grid back lc rgb '#e4e9ef'");
plot.cmd("set key outside top center horizontal");
plot.cmd("set style line 1 lc rgb '#007f86' lw 3");
plot.cmd("set style line 2 lc rgb '#df6b38' lw 3");
plot.cmd("set style line 3 lc rgb '#5864a8' lw 3");
plot.cmd("set title 'Thermal diffusion removes short wavelengths first'");
plot.cmd("set xlabel 'x along the middle of the plate (model units)'");
plot.cmd("set ylabel 'Temperature (relative)'");
plot.cmd("plot 'build/examples/heated_plate_initial.csv' using ($2==0.5?$1:1/0):4 with lines ls 2 title 'Initial', 'build/examples/heated_plate_final.csv' using ($2==0.5?$1:1/0):4 with lines ls 1 title 'After t=0.02'");
plot.close();
end _dsl_
savedsl(v,"build/visual/heated_plate.dslb");
r = system ${dsl_cli(v)} --dsl build/visual/heated_plate.dslb;
if (r.code!=0) { println(r.stdout); println(r.stderr); }
assert(r.code==0);

println("wrote images/heated_plate.png");
