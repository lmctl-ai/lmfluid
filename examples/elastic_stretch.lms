mkdir("build/examples");
p = _dsl_ cli="lmfluid" install="github:lmctl-ai/lmfluid@latest";
let f=fluid.elasticity(fluid.rect(12,12,1.0,1.0),1).lame(1.0,1.0).displacement(0,"0.1*x","0","0").solve();fluid.assert_close(f.l2_error_vector("0.1*x","0","0"),0.0,0.0000001);f.sample(21,21).save_csv("build/examples/elastic_stretch.csv");
end _dsl_
savedsl(p, "build/elastic_stretch.dslb");
r = system ${dsl_cli(p)} --dsl build/elastic_stretch.dslb;
assert(r.code == 0);

mkdir("build/visual");
mkdir("images");
v = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/elastic_stretch.png",900,520);
plot.cmd("set datafile separator ','");
plot.cmd("set border 3");
plot.cmd("set lmargin 14");
plot.cmd("set rmargin 12");
plot.cmd("set tics nomirror");
plot.cmd("set grid back lc rgb '#e4e9ef'");
plot.cmd("set key outside top center horizontal");
plot.cmd("set style line 1 lc rgb '#007f86' lw 3");
plot.cmd("set style line 2 lc rgb '#df6b38' lw 3");
plot.cmd("set style line 3 lc rgb '#5864a8' lw 3");
plot.cmd("set title 'Uniform axial strain: displacement enlarged four times'");
plot.cmd("set xlabel 'x (model units)'");
plot.cmd("set ylabel 'y (model units)'");
plot.cmd("set size ratio -1");
plot.cmd("set xrange [-0.05:1.45]");
plot.cmd("set yrange [-0.05:1.05]");
plot.cmd("plot 'build/examples/elastic_stretch.csv' using 1:2 with points pt 7 ps 0.6 lc rgb '#96a8b5' title 'Reference', '' using ($1+4*$4):($2+4*$5) with points pt 7 ps 0.6 lc rgb '#007f86' title 'Deformed (4x)'");
plot.close();
end _dsl_
savedsl(v,"build/visual/elastic_stretch.dslb");
r = system ${dsl_cli(v)} --dsl build/visual/elastic_stretch.dslb;
if (r.code!=0) { println(r.stdout); println(r.stderr); }
assert(r.code==0);

println("wrote images/elastic_stretch.png");
