mkdir("build/examples");
p = _lmcode_ cli="lmfluid" install="github:lmctl-ai/lmfluid@latest";
let mesh = fluid.rect(24, 24, 1.0, 1.0);
let field = fluid.poisson(mesh, 2).source("-4.0").dirichlet(0, "x*x + y*y").solve();
fluid.assert_close(field.l2_error("x*x + y*y"), 0.0, 0.005);
field.sample(41, 41).save_csv("build/examples/poisson.csv");
end _lmcode_
savedsl(p, "build/poisson.dslb");
r = system ${dsl_cli(p)} --dsl build/poisson.dslb;
assert(r.code == 0);

mkdir("build/visual");
mkdir("images");
v = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/poisson.png",900,520);
plot.cmd("set datafile separator ','");
plot.cmd("set border 3");
plot.cmd("set lmargin 14");
plot.cmd("set rmargin 12");
plot.cmd("set tics nomirror");
plot.cmd("set grid back lc rgb '#e4e9ef'");
plot.cmd("set key outside top center horizontal");
plot.cmd("set style line 1 lc rgb '#007f86' lw 3");
plot.cmd("set style line 2 lc rgb '#df6b38' lw 3");
plot.cmd("set style line 3 lc rgb '#5864a8' lw 3");
plot.cmd("set title 'Poisson field with a quadratic boundary potential'");
plot.cmd("set xlabel 'x (model units)'");
plot.cmd("set ylabel 'y (model units)'");
plot.cmd("set size ratio -1");
plot.cmd("set xrange [0:1]");
plot.cmd("set yrange [0:1]");
plot.cmd("set cbrange [0:2]");
plot.cmd("set palette defined (0 '#17324d', 0.5 '#159895', 1 '#fff2b2')");
plot.cmd("set cblabel 'Field value'");
plot.cmd("unset key");
plot.cmd("plot 'build/examples/poisson.csv' using 1:2:4 with image");
plot.close();
end _lmcode_
savedsl(v,"build/visual/poisson.dslb");
r = system ${dsl_cli(v)} --dsl build/visual/poisson.dslb;
if (r.code!=0) { println(r.stdout); println(r.stderr); }
assert(r.code==0);

println("wrote images/poisson.png");
